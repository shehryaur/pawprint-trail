# Password for the front door of the trail.
SITE_PASSWORD=your_gate_password_here

# Secret password for the locked celebration den (given after finishing).
FINALE_PASSWORD=your_finale_password_here

# Optional personalization for the finale letter.
LEARNER_NAME=Explorer
FRIEND_NOTE=Congratulations on finishing the trail!
FRIEND_SIGN=Your friend

# Supabase shared progress (optional).
# Run supabase/progress.sql in the Supabase SQL editor, then paste your project URL and service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
